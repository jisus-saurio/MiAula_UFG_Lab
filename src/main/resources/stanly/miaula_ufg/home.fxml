<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_CENTER" prefWidth="480.0" spacing="15.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" fx:controller="stanly.miaula_ufg.HomeController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblBienvenida" text="Bienvenido" style="-fx-font-size: 20px;" />
      <Label text="Registro de aulas" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

      <GridPane hgap="10.0" vgap="10.0">
         <columnConstraints>
            <ColumnConstraints minWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" />
         </columnConstraints>
         <children>
            <!-- Campos de filas 0 a 2 -->
            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" promptText="Ej. B-204" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Edificio:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtEdificio" promptText="Edificio del aula" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Planta:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbPlanta" promptText="Seleccione" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            
            <!-- Campos de esta parte (filas 3 a 6) -->
            <Label text="Capacidad:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="txtCapacidad" promptText="Personas que caben" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label text="Tipo de aula:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <ComboBox fx:id="cmbTipoAula" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Responsable:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <TextField fx:id="txtResponsable" promptText="Persona a cargo" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione" GridPane.columnIndex="1" GridPane.rowIndex="6" />
         </children>
      </GridPane>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#guardar" text="Guardar" defaultButton="true" />
            <Button onAction="#limpiar" text="Limpiar" />
         </children>
      </HBox>

      <Label fx:id="lblMensaje" wrapText="true" />
      <Hyperlink onAction="#cerrarSesion" text="Cerrar sesión" />
   </children>
</VBox>